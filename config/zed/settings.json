// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "git_panel": {
        "dock": "left"
    },
    "ui_font_size": 18,
    "buffer_font_size": 14,
    "project_panel": {
        "dock": "left"
    },
    "theme": {
        "mode": "dark",
        "light": "macOS Classic Light",
        "dark": "macOS Classic Dark",
    },
    "icon_theme": {
        "mode": "light",
        "light": "Zed (Default)",
        "dark": "Zed (Default)"
    },
    "base_keymap": "VSCode",
    "terminal": {
        "shell": {
            "program": "zsh",
        },
    },
    "debugger": {
        "dock": "left",
    },
    "tab_size": 4,
    "languages": {
        "JSON": {
            "tab_size": 2,
        },
        "YAML": {
            "tab_size": 2,
        },
    },
    "collaboration_panel": {
        "button": false
    },
    "agent": {
        "button": false,
        "favorite_models": [],
        "model_parameters": []
    },
    "edit_predictions": {
        "provider": "none",
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
